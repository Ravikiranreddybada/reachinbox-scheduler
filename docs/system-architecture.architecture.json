  "cards": [
    {
      "dot": "emerald",
      "title": "Durability contract",
      "items": [
        "PostgreSQL owns business state; Redis owns execution state",
        "Stable job IDs and startup reconciliation recover missing queue work"
      ]
    },
    {
      "dot": "amber",
      "title": "Delivery semantics",
      "items": [
        "At-least-once processing with idempotent scheduling",
        "SMTP acknowledgement crash windows are documented explicitly"
      ]
    },
