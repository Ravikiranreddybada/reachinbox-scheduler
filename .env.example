NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
# docker-compose runs Elasticsearch with security on; the user is `elastic`
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=reachinbox-dev
SESSION_SECRET=replace-with-32-byte-random-secret
# Required: base64 32-byte key for secrets at rest (openssl rand -base64 32). No fallback.
DATA_ENCRYPTION_KEY=
# Rotation: put the new key above, the old one here (comma list), then run `pnpm rotate-secrets`
DATA_ENCRYPTION_KEY_PREVIOUS=
BULL_BOARD_ADMIN_EMAILS=operator@example.com
# Optional: bearer token required by /metrics
METRICS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# smtp (Ethereal) or stream (in-process stub for load tests)
DELIVERY_TRANSPORT=smtp
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_FROM_NAME=ReachInbox Demo
# Run the delivery worker inside the API process (single-service hosting)
RUN_WORKER=false
# Set false to run without Elasticsearch (search is then unavailable)
SEARCH_ENABLED=true
WORKER_CONCURRENCY=8
# Minimum gap between two sends from the same sender, across all workers
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_PER_TENANT=5000
# One cap shared by every tenant
MAX_EMAILS_PER_HOUR_GLOBAL=20000
PROCESSING_LEASE_MS=300000
RECONCILE_INTERVAL_MS=300000
# Only emails due within this window own a BullMQ job; later ones wait in PostgreSQL
ENQUEUE_HORIZON_MS=21600000
# Per-worker memory budget for cached attachment bytes
ATTACHMENT_CACHE_BYTES=67108864
# Base URL used in unsubscribe links
API_PUBLIC_URL=http://localhost:4000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback
