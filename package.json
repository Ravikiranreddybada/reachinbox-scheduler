{
  "name": "reachinbox-scheduler",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @reachinbox/api dev\" \"pnpm --filter @reachinbox/web dev\"",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @reachinbox/api prisma:generate",
    "db:migrate": "pnpm --filter @reachinbox/api prisma:migrate",
    "worker": "pnpm --filter @reachinbox/api worker",
    "test": "vitest run --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm test && pnpm typecheck && pnpm build",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "pnpm --filter @reachinbox/api typecheck",
    "loadtest": "pnpm --filter @reachinbox/api loadtest",
    "ethereal:account": "pnpm --filter @reachinbox/api ethereal:account",
    "reindex": "pnpm --filter @reachinbox/api reindex",
    "rotate-secrets": "pnpm --filter @reachinbox/api rotate-secrets"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
