generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id              String           @id @default(cuid())
  googleId        String?          @unique
  passwordHash    String?
  email           String           @unique
  name            String
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  senders         Sender[]
  emails          Email[]
  campaigns       Campaign[]
  attachments     Attachment[]
  suppressions    Suppression[]
  slackConnection SlackConnection?
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  COMPLAINT
}

/// Recipients a user must not email again. The worker checks this before every send.
model Suppression {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  reason    SuppressionReason
  note      String?
  createdAt DateTime          @default(now())

  @@unique([userId, email])
}

/// Transactional outbox for the search projection. A row is written in the same
/// transaction as the email, and removed once the sync job is queued.
model SearchOutbox {
  id        Int      @id @default(autoincrement())
  emailId   String   @unique
  createdAt DateTime @default(now())
}

model Campaign {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String
  payloadHash    String
  hourlyLimit    Int?
  subject        String    @default("")
  /// The message body is stored once per campaign, not once per recipient.
  body           String?   @db.Text
  /// Plain-text snippet for list views, so lists never read the body.
  preview        String    @default("")
  recipientCount Int       @default(0)
  startsAt       DateTime?
  createdAt      DateTime  @default(now())
  emails         Email[]
  attachments    Attachment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model Sender {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  displayName String?
  /// Optional own SMTP login. Without it the sender uses the shared default account.
  smtpUser     String?
  /// AES-256-GCM ciphertext (enc:v1:...). See src/lib/crypto.ts.
  smtpPassword String?
  createdAt   DateTime @default(now())
  emails      Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Email {
  id                  String      @id @default(cuid())
  userId              String
  senderId            String
  campaignId          String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender              Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  campaign            Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient           String
  subject             String
  /// Legacy rows only. New rows read the body from Campaign.body.
  body                String?     @db.Text
  scheduledAt         DateTime
  sentAt              DateTime?
  status              EmailStatus @default(SCHEDULED)
  errorMessage        String?
  idempotencyKey      String
  attempts            Int         @default(0)
  processingStartedAt DateTime?
  providerMessageId   String?
  starred             Boolean     @default(false)
  archivedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status, scheduledAt])
  @@index([userId, status, sentAt])
  @@index([senderId, status, scheduledAt])
  @@index([status, processingStartedAt])
  @@index([campaignId, status])
  @@index([userId, deletedAt, archivedAt])
  @@index([status, scheduledAt])
}

model Attachment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null until the attachment is linked to a campaign at schedule time.
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now())

  @@index([userId, campaignId])
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String
  teamName    String?
  channelName String?
  /// AES-256-GCM ciphertext (enc:v1:...). See src/lib/crypto.ts.
  webhookUrl  String
  /// AES-256-GCM ciphertext (enc:v1:...).
  accessToken String?
  connectedAt DateTime @default(now())
}
